{
  "name": "@thezakman/mcp-screenshot",
  "version": "0.3.0",
  "description": "Window screenshots and traceable local evidence over MCP for macOS.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "mcp-screenshot": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/thezakman/mcp-screenshot.git"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run format:check && npm run typecheck && npm test && npm run build",
    "start": "node dist/index.js",
    "doctor": "node dist/index.js --doctor",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.0",
    "prettier": "^3.9.9",
    "typescript": "^5.7.0",
    "vitest": "^4.1.7"
  },
  "license": "MIT"
}
